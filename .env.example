TINYBOT_DOMAIN=bot.example.com
TELEGRAM_OPERATOR_ID=123456789
# Optional reviewer override. With no key, OpenRouter profiles use their own key.
# TINYBOT_REVIEW_MODEL=typesafe/jev-1.14
# TINYBOT_REVIEW_OPENROUTER_KEY=
# TINYBOT_BRAVE_SEARCH_KEY=
# Optional proxy for Chromium egress. An empty value uses direct connections.
# TINYBOT_BROWSER_PROXY=socks5://proxy.example.com:1080
# TINYBOT_TIMEZONE=UTC
# TINYBOT_MCP_READ_POLICY_PATH=./deploy/mcp-reads.json
